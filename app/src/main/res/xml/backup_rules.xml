<?xml version="1.0" encoding="utf-8"?>
<!--
    Respaldo de Android 11 y anteriores (API 24-30). Mismo contenido que
    data_extraction_rules.xml; ver la explicación allí.

    requireFlags="clientSideEncryption": son datos financieros, solo se suben a la nube si el
    teléfono puede cifrarlos (tiene bloqueo de pantalla). La transferencia entre teléfonos no
    usa estas reglas de cifrado.
-->
<full-backup-content>
    <include domain="database" path="." requireFlags="clientSideEncryption" />
    <include domain="file" path="datastore/" requireFlags="clientSideEncryption" />
</full-backup-content>
